# ── Core ──────────────────────────────────────────────────────────────────────
TLS_DATABASE_URL=postgresql+asyncpg://user:password@keural-postgres:5432/tls
TLS_REDIS_URL=redis://localhost:6379/0

# ── API keys ──────────────────────────────────────────────────────────────────
TLS_API_KEY=sk-tls-changeme
TLS_ADMIN_API_KEY=sk-tls-admin-changeme
TLS_REQUEST_TIMEOUT_MS=5000

# ── Business defaults ─────────────────────────────────────────────────────────
TLS_DEFAULT_TIER=free
TLS_GRACE_PERCENTAGE=5
TLS_REFUND_OVERESTIMATION=true
TLS_STRICT_MODE=false

# ── Feature flags ─────────────────────────────────────────────────────────────
TLS_ENABLE_ORG_LIMITS=true
TLS_ENABLE_CONCURRENT_LIMITS=true
TLS_ENABLE_MODEL_MULTIPLIERS=true

# ── Reaper ────────────────────────────────────────────────────────────────────
TLS_REAPER_INTERVAL_MINUTES=1
TLS_REAPER_STALE_THRESHOLD_MINUTES=5
